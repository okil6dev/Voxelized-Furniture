	if string.sub(arg1, 1, 3):lower() == "/w " or string.sub(arg1, 1, 9):lower() == "/whisper " then
		return module_upvr_2.new(arg2, arg3, arg4)
	end
	return nil
end
function CreateCustomState(arg1, arg2, arg3, arg4) -- Line 219
