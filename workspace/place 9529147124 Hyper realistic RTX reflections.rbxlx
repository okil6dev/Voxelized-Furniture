		[1]: module_upvr_2 (readonly)
	]]
	return module_upvr_2.new(arg2, arg3, arg4, arg1)
end
return {
	[module.KEY_COMMAND_PROCESSOR_TYPE] = module.IN_PROGRESS_MESSAGE_PROCESSOR;
	[module.KEY_PROCESSOR_FUNCTION] = ProcessMessage;
